{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codex-models",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // 静态资源：文档页、JSON Schema、OpenAPI、注册表静态底稿（PR 2）。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
  // 发布后的目录快照与元数据（读路径只读 KV）。id 留空 → wrangler deploy 自动创建。
  "kv_namespaces": [{ "binding": "CODEX_MODELS_KV" }],
  // 唯一的写者：同步协调器（SQLite 存储；持有加密后的 OAuth token、运行记录）。
  "durable_objects": {
    "bindings": [{ "name": "SYNC", "class_name": "SyncCoordinator" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncCoordinator"] }],
  // external 模式由 GitHub Actions 每小时同步；空列表在部署时移除旧 Worker 计划。
  "triggers": { "crons": [] },
  // 对外正式域名 codexdata.0xinf.net（0xinf.net zone 与本 Worker 同账号）。
  // workers.dev 地址保留，老引用（codex-pass、GitHub Actions 的 CODEX_MODELS_ORIGIN）不断。
  "routes": [{ "pattern": "codexdata.0xinf.net", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    // 对外链接的基准域名（/v1/index.json 与 build-static 烘焙的 index 链接都用它）。
    "CODEX_MODELS_PUBLIC_ORIGIN": "https://codexdata.0xinf.net",
    // "external"：目录由外部 agent（GitHub Actions，scripts/sync-agent.mjs）拉取后推回；
    // "worker"：DO 自己拉——Phase 0 探针显示 Workers 出口被 chatgpt.com 403，暂不可用。
    "SYNC_MODE": "external",
  },
}

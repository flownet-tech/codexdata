{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 退役部署：旧账号（Project 0xinf - FLOWNET，0738b660…）里的同名 Worker，
  // 只负责把 codexdata.0xinf.net 与 codex-models.flownet.workers.dev 301 到 data.cp.dev。
  // 正式实例用 wrangler.jsonc 部署到 FLOWNET APPS DEV，两份配置互不影响。
  "name": "codex-models",
  "main": "src/legacy-redirect.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // 旧 workers.dev 地址同样重定向。
  "workers_dev": true,
  // 刻意不配 assets：静态资源层直出会抢在 Worker 之前响应，/v1/features/* 就不会被重定向。
  // 2026-09-22 清理：删掉 KV 绑定与 SyncCoordinator（deleted_classes 会一并销毁 DO 存储里的
  // 加密 refresh token 与运行记录），KV namespace 也单独删除。退役 Worker 从此零绑定。
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyncCoordinator"] },
    { "tag": "v2", "deleted_classes": ["SyncCoordinator"] },
  ],
  "triggers": { "crons": [] },
  "routes": [{ "pattern": "codexdata.0xinf.net", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}

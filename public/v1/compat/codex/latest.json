  "advisories": [
    {
      "id": "2026-09-codex-0155-workspace-https-gate",
      "severity": "critical",
      "kind": "upgrade-risk",
      "status": "open",
      "clientAction": "hold-upgrade",
      "affects": {
        "min": "0.155.0",
        "max": null
      },
      "keys": [
        "chatgpt_base_url"
      ],
      "codexPassFixedIn": "0.5.2",
      "links": [
        "https://github.com/openai/codex"
      ],
      "i18n": {
        "en": {
          "title": "Codex 0.155 enforces HTTPS on the account backend",
          "body": "Starting with Codex 0.155, the workspace backend must be HTTPS; routing account traffic through the local proxy triggers a login wall. Codex Pass 0.5.2 (and 0.4.8) adapts by no longer taking over account traffic on 0.155+, which also disables access logging and privacy interception for account requests. Upgrade Codex Pass to 0.5.2 or later before upgrading Codex."
        },
        "ja": {
          "title": "Codex 0.155 以降、アカウント API は HTTPS 必須",
          "body": "Codex 0.155 以降、workspace バックエンドは HTTPS が必須となり、ローカルプロキシ経由のアカウントトラフィックはログイン画面でブロックされます。Codex Pass 0.5.2（および 0.4.8）は 0.155+ を検出するとアカウントトラフィックの引き受けを自動停止します（アカウント系リクエストのアクセスログとプライバシー遮断は無効になります）。Codex をアップグレードする前に、Codex Pass を 0.5.2 以降へ更新してください。"
        },
        "zh": {
          "title": "Codex 0.155 起账号接口强制 HTTPS",
          "body": "Codex 0.155 开始要求 workspace 后端为 HTTPS，经本机代理接管账号流量会触发登录墙。Codex Pass 0.5.2（及 0.4.8）已适配：检测到 0.155+ 时自动停止接管账号流量，访问日志与隐私拦截对账号类请求不再生效。请先升级 Codex Pass 到 0.5.2 或更高，再升级 Codex。"
        },
        "zh-TW": {
          "title": "Codex 0.155 起帳號介面強制 HTTPS",
          "body": "Codex 0.155 開始要求 workspace 後端為 HTTPS，經本機代理接管帳號流量會觸發登入牆。Codex Pass 0.5.2（及 0.4.8）已適配：偵測到 0.155+ 時自動停止接管帳號流量，存取日誌與隱私攔截對帳號類請求不再生效。請先升級 Codex Pass 到 0.5.2 或更高，再升級 Codex。"
        }
      }
    },
    {
      "id": "2026-09-codex-0156-daemon-auto-update",
      "severity": "warn",
      "kind": "behavior-change",
      "status": "open",
      "clientAction": "none",
      "affects": {
        "min": "0.156.0",
        "max": null
      },
      "keys": [
        "updater.autoUpdateEnabled",
        "check_for_update_on_startup"
      ],
      "links": [
        "https://github.com/openai/codex"
      ],
      "i18n": {
        "en": {
          "title": "Codex 0.156: the background daemon auto-updates Codex",
          "body": "Starting with Codex 0.156, sessions run through a shared background daemon by default, and the daemon has its own auto-update loop: enabled by default, it checks roughly every 60 minutes and installs new Codex versions automatically. check_for_update_on_startup in config.toml only controls the TUI startup prompt — setting it to false does not stop this loop. Teams that manage Codex versions centrally need to set updater.autoUpdateEnabled to false in the daemon state directory's settings.json ($CODEX_HOME/app-server-daemon/settings.json)."
        },
        "ja": {
          "title": "Codex 0.156 以降、バックグラウンド daemon が Codex を自動更新",
          "body": "Codex 0.156 以降、セッションはデフォルトで共有バックグラウンド daemon 経由で実行され、daemon は独自の自動更新ループを持ちます。デフォルトで有効になっており、約 60 分ごとに更新を確認して新しい Codex を自動インストールします。config.toml の check_for_update_on_startup は TUI 起動時の更新プロンプトのみを制御し、false にしてもこのループは止まりません。Codex のバージョンを集中管理しているチームは、daemon 状態ディレクトリの settings.json（$CODEX_HOME/app-server-daemon/settings.json）で updater.autoUpdateEnabled を false に設定してください。"
        },
        "zh": {
          "title": "Codex 0.156 起后台 daemon 会自动更新 Codex",
          "body": "Codex 0.156 起默认经由共享后台 daemon 运行，daemon 自带独立的自动更新循环：默认开启，约每 60 分钟检查一次并自动安装新版 Codex。config.toml 的 check_for_update_on_startup 只控制 TUI 启动时的更新提示，即使设为 false 也管不到这条循环。集中管理 Codex 版本的团队需要在 daemon 状态目录的 settings.json（$CODEX_HOME/app-server-daemon/settings.json）里把 updater.autoUpdateEnabled 设为 false。"
        },
        "zh-TW": {
          "title": "Codex 0.156 起背景 daemon 會自動更新 Codex",
          "body": "Codex 0.156 起預設經由共享背景 daemon 執行，daemon 自帶獨立的自動更新迴圈：預設開啟，約每 60 分鐘檢查一次並自動安裝新版 Codex。config.toml 的 check_for_update_on_startup 只控制 TUI 啟動時的更新提示，即使設為 false 也管不到這條迴圈。集中管理 Codex 版本的團隊需要在 daemon 狀態目錄的 settings.json（$CODEX_HOME/app-server-daemon/settings.json）裡把 updater.autoUpdateEnabled 設為 false。"
        }
      }
    }
  ],
